# Copiar a .env y completar. Nunca commitear el .env real.

# --- Base de datos (Postgres local via Docker) ---
DATABASE_URL=postgresql+psycopg://repusense:repusense@localhost:5432/repusense

# --- Cache y colas (Redis local via Docker) ---
REDIS_URL=redis://localhost:6379/0

# --- API ---
API_HOST=127.0.0.1
API_PORT=8000

# --- ETL ---
# Una "resena negativa" es rating <= 3. Decision del equipo.
# Consistente con el brief (< 3.5) porque review.rating es smallint 1-5.
ETL_NEGATIVE_RATING_MAX=3
# Maximo de resenas por negocio en cada corrida.
ETL_MAX_REVIEWS_PER_BUSINESS=50

# --- Discovery (SerpApi Google Maps; contrato en docs/fuente-de-discovery.md) ---
# Free tier: 250 busquedas/mes, 50/hora. Alta sin tarjeta en serpapi.com.
SERPAPI_KEY=
# Filtros del brief, aplicados post-fetch.
DISCOVERY_MAX_RATING=3.5
DISCOVERY_MIN_REVIEWS=10
# Maps corta a ~120 resultados por query (6 paginas de 20).
DISCOVERY_MAX_PAGINAS=6
# Cortesia entre paginas, en segundos (limite de la fuente: 50 busquedas/hora).
DISCOVERY_REQUEST_INTERVAL=2.0
