# Copiar a .env y completar. Nunca commitear el .env real.

# --- Base de datos (Postgres local via Docker) ---
DATABASE_URL=postgresql+psycopg://repusense:repusense@localhost:5432/repusense

# --- Cache y colas (Redis local via Docker) ---
REDIS_URL=redis://localhost:6379/0

# --- API ---
API_HOST=127.0.0.1
API_PORT=8000

# --- ETL ---
# Una "resena negativa" es rating <= 3. Decision del equipo.
# Consistente con el brief (< 3.5) porque review.rating es smallint 1-5.
ETL_NEGATIVE_RATING_MAX=3
# Maximo de resenas por negocio en cada corrida.
ETL_MAX_REVIEWS_PER_BUSINESS=50
