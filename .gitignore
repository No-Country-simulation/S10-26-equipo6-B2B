# ============================================================
# Secretos — NUNCA commitear estos archivos
# La clave service_role de Supabase otorga acceso TOTAL a la base
# de datos omiteando RLS. Si se filtra, hay acceso completo.
# ============================================================
.env
.env.*
!.env.example
!.env.sample
!.env.template
*.pem
*.key
service-account*.json

# ============================================================
# Node / Next.js
# ============================================================
node_modules/
.next/
out/
build/
dist/
.turbo/
next-env.d.ts
.vercel

# Registros (logs)
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Lockfiles de gestores de paquetes distintos al que use el equipo
# (package-lock.json SÍ se commitea; descomentar si se estandariza pnpm o yarn)
# pnpm-lock.yaml
# yarn.lock

# ============================================================
# Python (worker)
# ============================================================
__pycache__/
*.py[cod]
*$py.class
*.so

# Entornos virtuales
.venv/
venv/
env/
ENV/

# Empaquetado / build
*.egg-info/
.eggs/
dist/
build/

# Cachés de herramientas
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# ============================================================
# Datos generados — el worker los regenera; no son código fuente.
# Se conserva commiteada la evidencia del Demo Day (excepción abajo).
# ============================================================
/data/raw/
/data/tmp/
/data/cache/
*.csv
!docs/evidence/*.csv
*.jsonl
*.parquet

# Volcados de base de datos
*.sql.gz
/dumps/

# ============================================================
# Playwright / pruebas E2E
# ============================================================
test-results/
playwright-report/
blob-report/
.playwright/
.playwright-cache/

# ============================================================
# CLI de Supabase
# ============================================================
supabase/.temp/
supabase/.branches/

# ============================================================
# Editores y sistema operativo
# ============================================================
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp
*.swo

# Windows (artefactos de sincronización de OneDrive)
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Linux
*~
