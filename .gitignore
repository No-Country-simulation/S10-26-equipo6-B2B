# ============================================================
# 1. SECRETOS Y CREDENCIALES (OWASP A02:2021)
# NUNCA commitear credenciales, variables locales ni certificados.
# La base de datos es PostgreSQL 16 local en Docker (no Supabase).
# ============================================================
.env
.env.*
.env.local
.env.*.local
.env.backup
.env.production
.env.staging

# Whitelist estricta de plantillas
!.env.example
!.env.sample
!.env.template

# Certificados, llaves criptográficas y tokens
*.pem
*.key
*.pkcs12
*.p12
*.pfx
*.crt
*.csr
id_rsa*
id_ed25519*

# Cuentas de servicio y credenciales Cloud / BaaS
service-account*.json
*credentials*.json
*credential*.json
client_secret*.json
firebase-adminsdk*.json
gcp-key*.json
.aws/
.azure/

# Historiales y configuración de autenticación CLI
.netrc
.pypirc

# ============================================================
# 2. GESTORES DE PAQUETES (Monorepo estandarizado: pnpm y uv)
# pnpm-lock.yaml y uv.lock SÍ se versionan obligatoriamente.
# Bloquear lockfiles incompatibles de otros gestores:
# ============================================================
package-lock.json
yarn.lock
bun.lock
bun.lockb
Pipfile
Pipfile.lock
poetry.lock
pdm.lock

# ============================================================
# 3. FRONTEND (Vite / React / Node)
# ============================================================
node_modules/
dist/
dist-ssr/
.turbo/
*.local

# Registros (logs)
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ============================================================
# 4. PYTHON (FastAPI / RepuSense Core / uv)
# ============================================================
__pycache__/
*.py[cod]
*$py.class
*.so
.venv/
venv/
env/
ENV/

# Build y empaquetado
*.egg-info/
.eggs/
build/

# Cachés de herramientas
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# ============================================================
# 5. DATOS GENERADOS Y VOLCADOS
# ============================================================
/data/raw/
/data/tmp/
/data/cache/
*.csv
!docs/evidence/*.csv
*.jsonl
*.parquet
*.sql.gz
/dumps/

# ============================================================
# 6. TESTING Y QA (Pytest / Playwright)
# ============================================================
test-results/
playwright-report/
blob-report/
.playwright/
.playwright-cache/

# ============================================================
# 7. EDITORES E IDES
# ============================================================
# VSCode (conservar configuraciones de equipo)
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# JetBrains (PyCharm / WebStorm)
.idea/
*.iml
.idea_modules/

# Editores consola
*.swp
*.swo
*~

# ============================================================
# 8. SISTEMAS OPERATIVOS
# ============================================================
# Windows
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon?
._*
